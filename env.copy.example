# Smart-fill automatic copy rewriting (backend only).
# Local: merge these two entries into apps/web/.env.local.
# Production: set them in Vercel > backlink-tracker > Settings > Environment Variables
# for Production, then redeploy. A local .env.local does not update Vercel.
# Keep existing DATABASE_URL, BACKLINK_EXTENSION_TOKEN and TYPESAFE_API_KEY unchanged.
# Paste your own OpenAI API key after =. Never commit a filled-in copy of this file.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-5-nano
