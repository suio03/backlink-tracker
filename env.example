# ========================================
# Environment Configuration Template
# Copy to .env and update with your values
# ========================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=backlink_tracker
POSTGRES_USER=backlink_user
POSTGRES_PASSWORD=change_this_password

# Application Database URL
DATABASE_URL=postgresql://backlink_user:change_this_password@postgres:5432/backlink_tracker?sslmode=disable

# Application Configuration
NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# Security Configuration
NEXTAUTH_SECRET=your_super_secure_nextauth_secret_key_here_32chars_min
NEXTAUTH_URL=https://your-domain.com
BACKLINK_EXTENSION_TOKEN=replace_with_a_long_random_token
OPENAI_API_KEY=replace_with_your_backend_only_openai_key
OPENAI_CONTENT_MODEL=gpt-5-nano

# Dokploy/Production Settings
# Update NEXTAUTH_URL with your actual domain when deploying
# Generate secure passwords for production use

# Optional: Analytics & Monitoring
# SENTRY_DSN=your_sentry_dsn_here
# GOOGLE_ANALYTICS_ID=your_ga_id_here

# Development Override (when running locally)
# DATABASE_URL=postgresql://backlink_user:password@localhost:5432/backlink_tracker
# NEXTAUTH_URL=http://localhost:3001

# Current-page smart filling: keep this key on the backend only.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Copy generation reuses OPENAI_API_KEY and OPENAI_CONTENT_MODEL.
